+!#include <misc.h>
+
+subroutine clm_hydro_ice (clm)
+
+!=========================================================================
+!  SYMFLUENCE patch: land-ice tile hydrology.
+!
+!  Stock ParFlow-CLM never sets qflx_infl on land-ice tiles (clm_hydro_soil
+!  runs on soil tiles only), so rain, snowpack outflow and ice melt on a
+!  glacier never reach ParFlow; and because pfreadout overwrites h2osoi_liq
+!  from ParFlow saturation every step, ice melted by clm_meltfreeze vanishes.
+!
+!  Here, on land-ice tiles:
+!    melt  = ice lost from the column this step (dz*denice - h2osoi_ice, >= 0)
+!    infl  = qflx_top_soil - qflx_evap_grnd + melt/dtime   (as clm_hydro_soil)
+!    if infl < 0 (sublimation exceeds supply) the deficit comes from the ice
+!  and the column is then restored to full ice (the glacier is an unlimited
+!  ice store; glacier mass change = -(melt - deficit), logged per tile/step to
+!  glacier_ice.txt.<rank> (unit 2601, opened in clm.F90) as:
+!  istep  melt_mm  deficit_mm  infl_mm).
+!=========================================================================
+
+  use precision
+  use clmtype
+  use clm_varpar, only : nlevsoi
+  use clm_varcon, only : denice
+  implicit none
+
+  type (clm1d), intent(inout) :: clm
+  integer  :: j
+  real(r8) :: melt, deficit, full
+
+  melt = 0.d0
+  do j = 1, nlevsoi
+     full = clm%dz(j)*denice
+     melt = melt + max(0.d0, full - clm%h2osoi_ice(j))
+     clm%h2osoi_ice(j) = full
+  enddo
+  ! Step 1: drv_clmini filled the ice column using CLM's default layer thicknesses,
+  ! which ParFlow then replaces with its own dz; the gap is initialisation, not melt.
+  if (clm%istep <= 1) melt = 0.d0
+
+  clm%qflx_infl = clm%qflx_top_soil - clm%qflx_evap_grnd + melt/clm%dtime
+  deficit = 0.d0
+  if (clm%qflx_infl < 0.d0) then
+     deficit = -clm%qflx_infl*clm%dtime
+     clm%qflx_infl = 0.d0
+  endif
+  clm%qflx_drain = 0.d0
+  clm%qflx_surf  = 0.d0
+
+  write(2601,'(i8,3es14.6)') clm%istep, melt, deficit, clm%qflx_infl*clm%dtime
+
+end subroutine clm_hydro_ice
