+! Helpers exposed for direct native regression tests.
+pure subroutine exposedTerrainMoment(bed,surface,cell2hru,hru,threshold,cellArea,moment,area)
+real(rkind),intent(in)::bed(:,:),surface(:,:),cell2hru(:,:),threshold,cellArea
+integer(i4b),intent(in)::hru
+real(rkind),intent(out)::moment,area
+logical::mask(size(bed,1),size(bed,2))
+mask=int(cell2hru)==hru .and. surface-bed<=threshold
+area=real(count(mask),rkind)*cellArea
+moment=sum(bed,mask=mask)*cellArea
+end subroutine
+
+pure subroutine partitionGlacierArea(total,areas)
+real(rkind),intent(in)::total
+real(rkind),intent(inout)::areas(:)
+real(rkind)::occupied
+occupied=sum(areas)
+if(occupied>total) areas=areas*(total/occupied)
+end subroutine
